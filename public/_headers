# Cloudflare Pages — security & caching headers
# See: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Next.js static hydration requires inline scripts.
  # Cloudflare hosts are for the Super Bot Fight Mode challenge widget.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.cloudflare.com https://*.challenges.cloudflare.com; img-src 'self' https://*.cdninstagram.com https://*.fbcdn.net data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://ig-proxy.michaelt604.workers.dev; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:


# Cache static assets aggressively
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
